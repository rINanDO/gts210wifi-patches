From e2b52cc1856351ee7f24433b81f4d228cde5a996 Mon Sep 17 00:00:00 2001
From: Nolen Johnson <johnsonnolen@gmail.com>
Date: Sat, 29 Mar 2025 11:53:10 -0400
Subject: [PATCH 1/1] compat: Introduce protobuf v29

* For devices that don't/can't enable Treble, linker will
  enforce using system version of protobuf first, which
  breaks vendor processes relying on old vendorcompat
  protobuf.
* Provide a renamed one so linker finds only one matching
  SONAME.
* Copy the existing libraries from v29, rename, and --set-soname
  w/ patchelf 0.9 (0.18 breaks these libraries).

Change-Id: I01e98d05b0c3f67b00431bea0721738044659317
---
 Android.bp                                 |  36 +++++++++++++++++++++
 vndk/v29/arm/libprotobuf-cpp-full-v29.so   | Bin 0 -> 1713760 bytes
 vndk/v29/arm/libprotobuf-cpp-lite-v29.so   | Bin 0 -> 262964 bytes
 vndk/v29/arm64/libprotobuf-cpp-full-v29.so | Bin 0 -> 2241640 bytes
 vndk/v29/arm64/libprotobuf-cpp-lite-v29.so | Bin 0 -> 336496 bytes
 5 files changed, 36 insertions(+)
 create mode 100644 vndk/v29/arm/libprotobuf-cpp-full-v29.so
 create mode 100644 vndk/v29/arm/libprotobuf-cpp-lite-v29.so
 create mode 100644 vndk/v29/arm64/libprotobuf-cpp-full-v29.so
 create mode 100644 vndk/v29/arm64/libprotobuf-cpp-lite-v29.so

diff --git a/Android.bp b/Android.bp
index 68497cf..2ba8652 100644
--- a/Android.bp
+++ b/Android.bp
@@ -652,6 +652,42 @@ cc_library_shared {
     vendor: true,
 }
 
+cc_prebuilt_library_shared {
+    name: "libprotobuf-cpp-full-v29",
+    vendor: true,
+    strip: {
+        none: true,
+    },
+    target: {
+        android_arm: {
+            srcs: ["vndk/v29/arm/libprotobuf-cpp-full-v29.so"],
+        },
+        android_arm64: {
+            srcs: ["vndk/v29/arm64/libprotobuf-cpp-full-v29.so"],
+        },
+    },
+    compile_multilib: "both",
+    check_elf_files: false,
+}
+
+cc_prebuilt_library_shared {
+    name: "libprotobuf-cpp-lite-v29",
+    vendor: true,
+    strip: {
+        none: true,
+    },
+    target: {
+        android_arm: {
+            srcs: ["vndk/v29/arm/libprotobuf-cpp-lite-v29.so"],
+        },
+        android_arm64: {
+            srcs: ["vndk/v29/arm64/libprotobuf-cpp-lite-v29.so"],
+        },
+    },
+    compile_multilib: "both",
+    check_elf_files: false,
+}
+
 cc_prebuilt_library_shared {
     name: "libprotobuf-cpp-full-vendorcompat",
     stem: "libprotobuf-cpp-full",
diff --git a/vndk/v29/arm/libprotobuf-cpp-full-v29.so b/vndk/v29/arm/libprotobuf-cpp-full-v29.so
