@@ -291,7 +291,7 @@ binder::Status CameraClient::disconnect() {
 
     LOG1("disconnect X (pid %d)", callingPid);
     int32_t closeLatencyMs = ns2ms(systemTime() - startTime);
-    mCameraServiceProxyWrapper->logClose(mCameraIdStr, closeLatencyMs, false);
+    mCameraServiceProxyWrapper->logClose(mCameraIdStr, closeLatencyMs, false, /*errorState*/0);
     return res;
 }
 
@@ -1225,9 +1225,9 @@ status_t CameraClient::setVideoTarget(const sp<IGraphicBufferProducer>& bufferPr
     return INVALID_OPERATION;
 }
 
-status_t CameraClient::setAudioRestriction(int mode) {
+status_t CameraClient::setAudioRestriction(hardware::camera2::ICameraDeviceUser::AudioRestriction mode) {
     if (!isValidAudioRestriction(mode)) {
-        ALOGE("%s: invalid audio restriction mode %d", __FUNCTION__, mode);
+        ALOGE("%s: invalid audio restriction mode %d", __FUNCTION__, static_cast<int32_t>(mode));
         return BAD_VALUE;
     }
 
@@ -1238,10 +1238,10 @@ status_t CameraClient::setAudioRestriction(int mode) {
     return BasicClient::setAudioRestriction(mode);
 }
 
-int32_t CameraClient::getGlobalAudioRestriction() {
