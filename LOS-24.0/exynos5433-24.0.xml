<?xml version="1.0" encoding="UTF-8"?>
<!--
  Local manifest for the Samsung Galaxy Tab S2 9.7 Wi-Fi (gts210wifi, Exynos 5433).

  Copy to .repo/local_manifests/ in the LineageOS 24.0 source root.
  Every rINanDO repo below has a "lineage-24.0" branch; create-lineage-24.0-branches.sh
  reads the <project path> entries from this file.
-->
<manifest>

  <!-- DEVICE -->
  <project path="device/samsung/gts2-common"          name="rINanDO/android_device_samsung_gts2-common"          remote="github" revision="lineage-24.0" />
  <project path="device/samsung/gts210wifi"           name="rINanDO/android_device_samsung_gts210wifi"           remote="github" revision="lineage-24.0" />
  <project path="device/samsung_slsi/sepolicy"        name="rINanDO/android_device_samsung_slsi_sepolicy"        remote="github" revision="lineage-24.0" />

  <!-- KERNEL -->
  <project path="kernel/samsung/universal5433"        name="rINanDO/android_kernel_samsung_universal5433"        remote="github" revision="lineage-24.0" />

  <!-- KERNEL TOOLCHAIN
       Dropped from the main manifest in de40b97 ("manifest: Drop GCC prebuilts"). This
       3.10 kernel predates clang-built-linux support and still needs a GCC cross-compiler. -->
  <project path="prebuilts/gcc/linux-x86/arm/arm-linux-androideabi-4.9" name="LineageOS/android_prebuilts_gcc_linux-x86_arm_arm-linux-androideabi-4.9" remote="github" revision="lineage-19.1" groups="pdk,linux,arm" clone-depth="1" />

  <!-- HARDWARE -->
  <project path="hardware/samsung"                    name="rinando/android_hardware_samsung"                    remote="github" revision="lineage-24.0" />
  <project path="hardware/samsung_slsi/exynos"        name="rINanDO/android_hardware_samsung_slsi_exynos"        remote="github" revision="lineage-24.0" />
  <project path="hardware/samsung_slsi/exynos5"       name="rINanDO/android_hardware_samsung_slsi_exynos5"       remote="github" revision="lineage-24.0" />
  <project path="hardware/samsung_slsi/exynos5433"    name="rINanDO/android_hardware_samsung_slsi_exynos5433"    remote="github" revision="lineage-24.0" />
  <project path="hardware/samsung_slsi/openmax"       name="rINanDO/android_hardware_samsung_slsi_openmax"       remote="github" revision="lineage-24.0" />

  <!-- VENDOR -->
  <project path="vendor/samsung"                      name="rINanDO/proprietary_vendor_samsung"                  remote="github" revision="lineage-24.0" />

</manifest>
