From 0d6ff367345815f236334317636008a2900abdeb Mon Sep 17 00:00:00 2001
From: Dominggoes Isakh <drjisakh@gmail.com>
Date: Mon, 26 Oct 2026 12:03:07 +0100
Subject: [PATCH 6/6] aidl: fingerprint: also enumerate templates in the legacy
 data dir

Older libbauthserver.so builds, such as the exynos5433 one, don't export
ss_fingerprint_enumerate, so the HAL lists the template files itself. It
only looked in /data/vendor/biometrics/fp/User_N/, but these blobs keep
their templates in /data/biometrics/fp/User_N/ regardless of the path
passed to set_active_group. The HAL reported no enrollments, and
FingerprintService removed every fingerprint on the next boot.

Scan the legacy dir too, skip duplicates, and only accept file names that
fully match User_%d_%dtmpl.dat.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Change-Id: Icd09cf21e11734632ece8bd882a1c28b335e7f96
---
 aidl/fingerprint/Session.cpp | 25 +++++++++++++++++--------
 aidl/fingerprint/Session.h   |  1 +
 2 files changed, 18 insertions(+), 8 deletions(-)

diff --git a/aidl/fingerprint/Session.cpp b/aidl/fingerprint/Session.cpp
index 722190d..6114e96 100644
--- a/aidl/fingerprint/Session.cpp
+++ b/aidl/fingerprint/Session.cpp
@@ -13,6 +13,7 @@
 
 #include <android-base/logging.h>
 
+#include <algorithm>
 #include <dirent.h>
 #include <endian.h>
 #include <thread>
@@ -126,22 +127,30 @@ ndk::ScopedAStatus Session::enumerateEnrollments() {
             LOG(ERROR) << "ss_fingerprint_enumerate failed: " << error;
     } else {
         std::vector<int> enrollments;
-        char filename[64];
-        snprintf(filename, sizeof(filename), FINGERPRINT_DATA_DIR, mUserId);
 
-        DIR* directory = opendir(filename);
-        if (directory) {
+        // Older libbauthserver.so builds without ss_fingerprint_enumerate store
+        // their templates in the legacy path, whatever set_active_group was given.
+        for (const char* dir : {FINGERPRINT_DATA_DIR, FINGERPRINT_LEGACY_DATA_DIR}) {
+            char filename[64];
+            snprintf(filename, sizeof(filename), dir, mUserId);
+
+            DIR* directory = opendir(filename);
+            if (!directory) {
+                LOG(WARNING) << "Failed to open " << filename;
+                continue;
+            }
+
             struct dirent* entry;
             while ((entry = readdir(directory))) {
                 int uid, fid;
-                if (sscanf(entry->d_name, "User_%d_%dtmpl.dat", &uid, &fid)) {
-                    if (uid == mUserId)
+                if (sscanf(entry->d_name, "User_%d_%dtmpl.dat", &uid, &fid) == 2) {
+                    if (uid == mUserId &&
+                        std::find(enrollments.begin(), enrollments.end(), fid) ==
+                                enrollments.end())
                         enrollments.push_back(fid);
                 }
             }
             closedir(directory);
-        } else {
-            LOG(WARNING) << "Failed to open " << filename;
         }
 
         mCb->onEnrollmentsEnumerated(enrollments);
diff --git a/aidl/fingerprint/Session.h b/aidl/fingerprint/Session.h
index cc91831..030a082 100644
--- a/aidl/fingerprint/Session.h
+++ b/aidl/fingerprint/Session.h
@@ -15,6 +15,7 @@
 #include "LockoutTracker.h"
 
 #define FINGERPRINT_DATA_DIR "/data/vendor/biometrics/fp/User_%d/"
+#define FINGERPRINT_LEGACY_DATA_DIR "/data/biometrics/fp/User_%d/"
 
 using ::aidl::android::hardware::biometrics::common::ICancellationSignal;
 using ::aidl::android::hardware::biometrics::common::OperationContext;
