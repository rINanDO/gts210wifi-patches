index 89469522c61e..ce900afb91c0 100644
--- a/core/java/android/hardware/camera2/legacy/CameraDeviceUserShim.java
+++ b/core/java/android/hardware/camera2/legacy/CameraDeviceUserShim.java
@@ -718,6 +718,11 @@ public class CameraDeviceUserShim implements ICameraDeviceUser {
         // TODO: b/63912484 implement updateOutputConfiguration.
     }
 
+    @Override
+    public void updateOutputConfigurations(int[] streamIds, OutputConfiguration[] configs) {
+        // TODO: b/63912484 implement updateOutputConfigurations.
+    }
