From 78747c913ed02cfd2be8cb377a9a78e50786a48c Mon Sep 17 00:00:00 2001
From: Dominggoes Isakh <drjisakh@gmail.com>
Date: Thu, 18 Jun 2026 19:50:29 +0200
Subject: [PATCH] exynos5433: Move to vendor and fix build errors

Change-Id: I737bd16ee564fd49fa52414e21ea075754d6642f
---
 gralloc/Android.mk            | 5 +++--
 libcamera/Android.mk          | 1 +
 libcamera3/Android.mk         | 1 +
 libcameraInterface/Android.mk | 1 +
 libcamera_external/Android.mk | 1 +
 libgatekeeper/Android.mk      | 1 +
 libkeymaster/Android.mk       | 1 +
 libsecurepath/Android.mk      | 1 +
 8 files changed, 10 insertions(+), 2 deletions(-)

diff --git a/gralloc/Android.mk b/gralloc/Android.mk
index a9788e5..184ed12 100644
--- a/gralloc/Android.mk
+++ b/gralloc/Android.mk
@@ -20,7 +20,7 @@ LOCAL_PATH := $(call my-dir)
 include $(CLEAR_VARS)
 
 LOCAL_MODULE_RELATIVE_PATH:= hw
-#LOCAL_MODULE_PATH := $(TARGET_OUT_VENDOR_SHARED_LIBRARIES)/hw
+LOCAL_VENDOR_MODULE := true
 LOCAL_SHARED_LIBRARIES := liblog libcutils libion libutils
 
 ifneq ($(TARGET_SOC), exynos5420)
@@ -32,7 +32,8 @@ MALI_AFBC_GRALLOC := 1
 LOCAL_C_INCLUDES := \
 	$(LOCAL_PATH)/../include \
 	$(TOP)/hardware/samsung_slsi/exynos/include \
-	$(TOP)/hardware/samsung_slsi/exynos5/include
+	$(TOP)/hardware/samsung_slsi/exynos5/include \
+	$(TOP)/hardware/libhardware/include
 
 LOCAL_SRC_FILES := 	\
 	format_chooser.cpp \
diff --git a/libcamera/Android.mk b/libcamera/Android.mk
index 33eef2d..bfc90ce 100644
--- a/libcamera/Android.mk
+++ b/libcamera/Android.mk
@@ -142,6 +142,7 @@ $(foreach file,$(LOCAL_SRC_FILES),$(shell touch '$(LOCAL_PATH)/$(file)'))
 
 LOCAL_MODULE_TAGS := optional
 LOCAL_MODULE := libexynoscamera
+LOCAL_PROPRIETARY_MODULE := true
 
 include $(TOP)/hardware/samsung_slsi/exynos/BoardConfigCFlags.mk
 include $(BUILD_SHARED_LIBRARY)
diff --git a/libcamera3/Android.mk b/libcamera3/Android.mk
index f9d80cc..5c2bdd2 100644
--- a/libcamera3/Android.mk
+++ b/libcamera3/Android.mk
@@ -132,6 +132,7 @@ $(foreach file,$(LOCAL_SRC_FILES),$(shell touch '$(LOCAL_PATH)/$(file)'))
 
 LOCAL_MODULE_TAGS := optional
 LOCAL_MODULE := libexynoscamera3
+LOCAL_PROPRIETARY_MODULE := true
 
 include $(TOP)/hardware/samsung_slsi/exynos/BoardConfigCFlags.mk
 include $(BUILD_SHARED_LIBRARY)
diff --git a/libcameraInterface/Android.mk b/libcameraInterface/Android.mk
index 649c52b..9ab5e40 100644
--- a/libcameraInterface/Android.mk
+++ b/libcameraInterface/Android.mk
@@ -118,6 +118,7 @@ LOCAL_MODULE := camera.$(TARGET_BOOTLOADER_BOARD_NAME)
 #LOCAL_MODULE := camera.$(TARGET_BOARD_PLATFORM)
 endif
 LOCAL_MODULE_TAGS := optional
+LOCAL_PROPRIETARY_MODULE := true
 
 LOCAL_CFLAGS += -D$(shell echo $(project_camera) | tr a-z A-Z)_CAMERA
 
diff --git a/libcamera_external/Android.mk b/libcamera_external/Android.mk
index 5e45b87..32b7cb8 100644
--- a/libcamera_external/Android.mk
+++ b/libcamera_external/Android.mk
@@ -162,6 +162,7 @@ LOCAL_SHARED_LIBRARIES:= libutils libcutils libbinder liblog libcamera_client li
 LOCAL_SHARED_LIBRARIES += libexynosutils libhwjpeg libexynosv4l2 libcsc libion libexynoscameraexternal
 
 LOCAL_MODULE := camera.$(TARGET_BOOTLOADER_BOARD_NAME)
+LOCAL_PROPRIETARY_MODULE := true
 
 LOCAL_MODULE_TAGS := optional
 
diff --git a/libgatekeeper/Android.mk b/libgatekeeper/Android.mk
index 64389ce..9b9bc99 100644
--- a/libgatekeeper/Android.mk
+++ b/libgatekeeper/Android.mk
@@ -22,6 +22,7 @@ CURRENT_PATH := hardware/samsung_slsi/$(TARGET_SOC)/libgatekeeper
 LOCAL_MODULE := gatekeeper.$(TARGET_SOC)
 
 LOCAL_MODULE_RELATIVE_PATH := hw
+LOCAL_PROPRIETARY_MODULE := true
 
 LOCAL_SRC_FILES := exynos_gatekeeper.cpp \
 		   tlcTeeGatekeeper_if.cpp
diff --git a/libkeymaster/Android.mk b/libkeymaster/Android.mk
index b8db57b..07dd2e1 100644
--- a/libkeymaster/Android.mk
+++ b/libkeymaster/Android.mk
@@ -21,6 +21,7 @@ MOBICORE_PATH := hardware/samsung_slsi/$(TARGET_SOC)/mobicore
 
 LOCAL_MODULE := keystore.exynos7570
 LOCAL_MODULE_RELATIVE_PATH := hw
+LOCAL_PROPRIETARY_MODULE := true
 
 ifeq ($(BOARD_USES_KEYMASTER_VER1), true)
 LOCAL_CPPFLAGS := -Wall
diff --git a/libsecurepath/Android.mk b/libsecurepath/Android.mk
index 1e0a279..2eeaa5f 100644
--- a/libsecurepath/Android.mk
+++ b/libsecurepath/Android.mk
@@ -22,6 +22,7 @@ LOCAL_PATH := $(call my-dir)
 # libcsecurepath.a
 include $(CLEAR_VARS)
 LOCAL_MODULE	:= libsecurepath
+LOCAL_PROPRIETARY_MODULE := true
 BUILD_DATE	:= \"`date '+%Y.%m.%d'`\"
 LOCAL_CPPFLAGS	:= -Wall -D_BUILD_DATE=$(BUILD_DATE)
 LOCAL_SRC_FILES	+= 	\
-- 
2.51.0

